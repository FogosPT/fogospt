{
    "private": true,
    "engines": {
        "node": ">=20"
    },
    "browserslist": [
        "defaults"
    ],
    "scripts": {
        "build": "sass --no-source-map --style=compressed resources/assets/sass/app.scss public/css/app.css && postcss public/css/app.css --use autoprefixer --no-map -r",
        "dev": "sass --embed-source-map resources/assets/sass/app.scss public/css/app.css",
        "watch": "sass --watch --embed-source-map resources/assets/sass/app.scss public/css/app.css",
        "lint:js": "node scripts/check-js.js",
        "test:smoke": "playwright test -c tests/smoke"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.0",
        "autoprefixer": "^10.4.21",
        "postcss": "^8.5.6",
        "postcss-cli": "^11.0.1",
        "sass": "^1.102.0"
    }
}
