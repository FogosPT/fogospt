APP_NAME=Laravel
# Production must run with APP_ENV=production and APP_DEBUG=false — a debug
# error page leaks env values and secrets.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# `stack` writes to storage/logs/laravel-YYYY-MM-DD.log, rotated after 7 days.
LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_DRIVER=redis
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Token for source.fogos.pt (sent as the FPTS header — never to third parties).
FPTS=
# Override only for local development / tests.
# FOGOS_API_URL=https://source.fogos.pt

# Firebase web push (FCM). The service account JSON mints the OAuth token
# used for topic subscribe/unsubscribe.
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# URL of the og-renderer sidecar (Puppeteer HTTP wrapper) that renders the
# per-fire social share card. Must be reachable from PHP-FPM. Default is
# the compose service name; leave empty to disable dynamic cards. The
# controller pre-renders the Blade to HTML and POSTs it here — the sidecar
# does not navigate back into this app.
OG_RENDERER_URL=http://og-renderer:3000

GAIA_API_BASE=https://wildfires.gaia-project.cloud/api
GAIA_API_KEY=

GOOGLE_ANALYTICS=UA-29689840-2
